# docker shit
func db() {
    sudo docker build -t "$1" --secret id=aws,src=$HOME/.aws/credentials -f "$2" .
}

func dr() {
    sudo docker run -v $HOME/.aws/credentials:/root/.aws/credentials:ro "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9"
}

